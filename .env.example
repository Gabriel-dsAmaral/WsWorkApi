# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wsworkapi

# JWT
JWT_SECRET=change-me-use-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Application
APP_NAME=Cars API
APP_VERSION=1.0.0
DEBUG=true

# CORS (frontend React/Vite)
# Desenvolvimento: com DEBUG=true, http://localhost:5173 é permitido automaticamente.
# Produção: defina origens explícitas; previews Vercel usam regex padrão (*.vercel.app).
BACKEND_CORS_ORIGINS=http://localhost:5173
# BACKEND_CORS_ORIGINS=[http://localhost:5173,https://seu-app.vercel.app]
# BACKEND_CORS_ORIGIN_REGEX=^https://[\w-]+(-[\w-]+)*\.vercel\.app$
BACKEND_CORS_ALLOW_CREDENTIALS=true

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
